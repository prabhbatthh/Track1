APP_NAME=MAY2026 Team 041 API
APP_ENV=development
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET=dev-secret-change-me
GOOGLE_CLIENT_ID=

# Left blank in dev — Razorpay order creation 503s until test-mode keys are set.
# Get test keys from the Razorpay Dashboard > Settings > API Keys (no live/business
# verification needed for test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Chatbot LLM backend ────────────────────────────────────────────────────────
# Set LLM_MODE to one of: openai | bedrock | ollama
LLM_MODE=ollama

# OpenAI (used when LLM_MODE=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS Bedrock (used when LLM_MODE=bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Ollama (used when LLM_MODE=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Separate model, only used for "You may also like" book similarity — not the chat model.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Left blank in dev — loan reminder emails are logged to the console instead of sent.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_USE_TLS=true
