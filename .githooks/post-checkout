#!/bin/sh
# Fires after `git checkout`. Git passes: $1=previous HEAD, $2=new HEAD,
# $3=1 for a branch switch, 0 for a plain file checkout (e.g. `git checkout -- file`,
# which never touches schema.prisma content in a way worth reacting to here).
prev_head="$1"
new_head="$2"
is_branch_switch="$3"

if [ "$is_branch_switch" = "1" ]; then
    "$(git rev-parse --show-toplevel)/.githooks/lib/regenerate-prisma-if-schema-changed.sh" "$prev_head" "$new_head"
fi
